rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Default-Deny Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // -------------------------------------------------------------------------
    // Global Hardened Primitives
    // -------------------------------------------------------------------------
    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isSignedIn() {
      return request.auth != null;
    }

    function isVerified() {
      return isSignedIn() && request.auth.token.email_verified == true;
    }

    function isValidId(id) {
      return id is string && id.size() >= 2 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function isAdmin() {
      return isVerified() && (
        request.auth.token.email == 'yasin.ladab.28@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid))
      );
    }

    // -------------------------------------------------------------------------
    // Entity Validation Blueprints (Anti-Update-Gap)
    // -------------------------------------------------------------------------
    function isValidProduct(data) {
      return data.keys().hasAll([
          'id', 'name', 'slug', 'description', 'category',
          'price500g', 'price1kg', 'discountPercent', 'imageUrl',
          'isAvailable', 'isEggless', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'id', 'name', 'slug', 'description', 'category',
          'price500g', 'price1kg', 'discountPercent', 'imageUrl',
          'isAvailable', 'isEggless', 'createdAt', 'updatedAt'
        ])
        && isValidId(data.id)
        && data.name is string && data.name.size() >= 2 && data.name.size() <= 100
        && data.slug is string && data.slug.size() >= 2 && data.slug.size() <= 120 && data.slug.matches('^[a-z0-9\\-]+$')
        && data.description is string && data.description.size() >= 10 && data.description.size() <= 1000
        && data.category in ['Chocolate', 'Fruit & Cream', 'Signature Crunch', 'Specials']
        && data.price500g is number && data.price500g > 0 && data.price500g <= 50000
        && data.price1kg is number && data.price1kg > 0 && data.price1kg <= 100000
        && data.discountPercent is number && data.discountPercent >= 0 && data.discountPercent <= 50
        && data.imageUrl is string && data.imageUrl.size() >= 4 && data.imageUrl.size() <= 1500
        && data.isAvailable is bool
        && data.isEggless is bool
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidOrder(data) {
      return data.keys().hasAll([
          'orderId', 'idempotencyKey', 'userId', 'customerName', 'phone',
          'address', 'items', 'subtotal', 'discountTotal', 'totalAmount',
          'paymentMethod', 'paymentStatus', 'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'orderId', 'idempotencyKey', 'userId', 'customerName', 'phone',
          'address', 'deliveryNotes', 'items', 'complimentaryItem',
          'subtotal', 'discountTotal', 'totalAmount',
          'paymentMethod', 'paymentStatus', 'status', 'adminNotes',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.orderId)
        && isValidId(data.idempotencyKey)
        && data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128
        && data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 100
        && data.phone is string && data.phone.size() >= 10 && data.phone.size() <= 15
        && data.address is string && data.address.size() >= 5 && data.address.size() <= 400
        && (!('deliveryNotes' in data) || (data.deliveryNotes is string && data.deliveryNotes.size() <= 300))
        && (!('complimentaryItem' in data) || (data.complimentaryItem is string && data.complimentaryItem.size() <= 120))
        && (!('adminNotes' in data) || (data.adminNotes is string && data.adminNotes.size() <= 400))
        && data.items is list && data.items.size() >= 1 && data.items.size() <= 20
        && data.items[0] is map
        && data.subtotal is number && data.subtotal > 0 && data.subtotal <= 500000
        && data.discountTotal is number && data.discountTotal >= 0 && data.discountTotal <= data.subtotal
        && data.totalAmount is number && data.totalAmount > 0 && data.totalAmount <= data.subtotal
        && data.paymentMethod in ['COD', 'PICKUP']
        && data.paymentStatus in ['Pending', 'Paid']
        && data.status in ['Pending', 'Confirmed', 'Preparing', 'Ready', 'Out for Delivery', 'Delivered', 'Cancelled']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidCustomCakeRequest(data) {
      return data.keys().hasAll([
          'requestId', 'userId', 'customerName', 'phone', 'occasion',
          'preferredFlavour', 'weight', 'designDescription', 'deliveryDate',
          'status', 'createdAt', 'updatedAt'
        ])
        && data.keys().hasOnly([
          'requestId', 'userId', 'customerName', 'phone', 'occasion',
          'preferredFlavour', 'weight', 'designDescription', 'deliveryDate',
          'referenceImageUrl', 'status', 'quotedAmount', 'adminNotes',
          'createdAt', 'updatedAt'
        ])
        && isValidId(data.requestId)
        && data.userId is string && data.userId.size() >= 1 && data.userId.size() <= 128
        && data.customerName is string && data.customerName.size() >= 2 && data.customerName.size() <= 100
        && data.phone is string && data.phone.size() >= 10 && data.phone.size() <= 15
        && data.occasion is string && data.occasion.size() >= 2 && data.occasion.size() <= 100
        && data.preferredFlavour is string && data.preferredFlavour.size() >= 2 && data.preferredFlavour.size() <= 100
        && data.weight is string && data.weight.size() >= 2 && data.weight.size() <= 40
        && data.designDescription is string && data.designDescription.size() >= 10 && data.designDescription.size() <= 1200
        && data.deliveryDate is string && data.deliveryDate.size() >= 8 && data.deliveryDate.size() <= 30
        && (!('referenceImageUrl' in data) || (data.referenceImageUrl is string && data.referenceImageUrl.size() <= 1500))
        && (!('quotedAmount' in data) || (data.quotedAmount is number && data.quotedAmount >= 0 && data.quotedAmount <= 500000))
        && (!('adminNotes' in data) || (data.adminNotes is string && data.adminNotes.size() <= 500))
        && data.status in ['New', 'Quoted', 'Accepted', 'Declined']
        && data.createdAt is timestamp
        && data.updatedAt is timestamp;
    }

    function isValidAdminDoc(data) {
      return data.keys().hasAll(['uid', 'email', 'role', 'createdAt'])
        && data.keys().hasOnly(['uid', 'email', 'name', 'role', 'createdAt'])
        && data.uid is string && data.uid.size() >= 1 && data.uid.size() <= 128
        && data.email is string && data.email.size() >= 5 && data.email.size() <= 160
        && (!('name' in data) || (data.name is string && data.name.size() <= 100))
        && data.role == 'admin'
        && data.createdAt is timestamp;
    }

    // -------------------------------------------------------------------------
    // Collection Match Blocks
    // -------------------------------------------------------------------------
    match /products/{productId} {
      allow get: if isValidId(productId);
      allow list: if true;
      allow create: if isAdmin()
        && isValidId(productId)
        && isValidProduct(incoming())
        && incoming().id == productId
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(productId)
        && isValidProduct(incoming())
        && incoming().id == existing().id
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time;
      allow delete: if isAdmin() && isValidId(productId);
    }

    match /orders/{orderId} {
      allow get: if isValidId(orderId) && (
        isAdmin() || (isVerified() && existing().userId == request.auth.uid)
      );
      allow list: if isAdmin() || (isVerified() && resource.data.userId == request.auth.uid);
      allow create: if isVerified()
        && isValidId(orderId)
        && isValidOrder(incoming())
        && incoming().orderId == orderId
        && incoming().userId == request.auth.uid
        && incoming().status == 'Pending'
        && incoming().paymentStatus == 'Pending'
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(orderId)
        && isValidOrder(incoming())
        && incoming().orderId == existing().orderId
        && incoming().idempotencyKey == existing().idempotencyKey
        && incoming().userId == existing().userId
        && incoming().totalAmount == existing().totalAmount
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'paymentStatus', 'adminNotes', 'updatedAt']);
      allow delete: if false;
    }

    match /orderIdempotency/{keyId} {
      allow get: if isValidId(keyId) && (
        isAdmin() || (isVerified() && existing().userId == request.auth.uid)
      );
      allow list: if false;
      allow create: if isVerified()
        && isValidId(keyId)
        && incoming().keys().hasAll(['orderId', 'userId', 'createdAt'])
        && incoming().keys().hasOnly(['orderId', 'userId', 'createdAt'])
        && isValidId(incoming().orderId)
        && incoming().userId == request.auth.uid
        && incoming().createdAt == request.time;
      allow update, delete: if false;
    }

    match /customCakeRequests/{requestId} {
      allow get: if isValidId(requestId) && (
        isAdmin() || (isVerified() && existing().userId == request.auth.uid)
      );
      allow list: if isAdmin() || (isVerified() && resource.data.userId == request.auth.uid);
      allow create: if isVerified()
        && isValidId(requestId)
        && isValidCustomCakeRequest(incoming())
        && incoming().requestId == requestId
        && incoming().userId == request.auth.uid
        && incoming().status == 'New'
        && !('quotedAmount' in incoming())
        && incoming().createdAt == request.time
        && incoming().updatedAt == request.time;
      allow update: if isAdmin()
        && isValidId(requestId)
        && isValidCustomCakeRequest(incoming())
        && incoming().requestId == existing().requestId
        && incoming().userId == existing().userId
        && incoming().createdAt == existing().createdAt
        && incoming().updatedAt == request.time
        && incoming().diff(existing()).affectedKeys().hasOnly(['status', 'quotedAmount', 'adminNotes', 'updatedAt']);
      allow delete: if isAdmin() && isValidId(requestId);
    }

    match /admins/{adminId} {
      allow get: if isValidId(adminId) && (
        isAdmin() || (isSignedIn() && request.auth.uid == adminId)
      );
      allow list: if isAdmin();
      allow create, update: if isAdmin()
        && isValidId(adminId)
        && isValidAdminDoc(incoming())
        && incoming().uid == adminId
        && incoming().createdAt == request.time;
      allow delete: if isAdmin() && isValidId(adminId);
    }
  }
}
